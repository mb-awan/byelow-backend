{
  "name": "byelow-backend",
  "version": "1.0.0",
  "description": "An Express Typescript backend for Byelow SEO Platform - serves both byelow-dashboard and byelow-frontend",
  "author": "Muhammad Bilal Nadeem Awan",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch --clear-screen=false src/index.ts | pino-pretty",
    "stage": "cross-env NODE_ENV=staging node dist/index.js",
    "build": "cross-env NODE_ENV=production rimraf dist && tsup",
    "build:prod": "cross-env NODE_ENV=production tsup src/index.ts --out-dir dist",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "start:pm2": "cross-env NODE_ENV=production pm2 start ecosystem.config.js --env production",
    "watch:log": "pm2 logs 'byelow-backend'",
    "seed:dev": "cross-env NODE_ENV=development tsx src/seeders/index.ts | pino-pretty",
    "seed:prod": "cross-env NODE_ENV=production tsx src/seeders/index.ts | pino-pretty",
    "start-docker:dev": "cross-env NODE_ENV=development.docker docker compose -f docker-compose.dev.yml up --build",
    "install-dependencies-docker:dev": "docker exec -it dev-api-server npm ci",
    "stop-docker:dev": "docker compose -f docker-compose.dev.yml down",
    "start-docker:prod": "cross-env NODE_ENV=production docker compose -f docker-compose.yml up -d",
    "install-dependencies-docker:prod": "docker exec -it byelow-api-server npm ci",
    "docker-watch-app-logs:prod": "docker logs -f byelow-api-server",
    "stop-docker:prod": "docker compose -f docker-compose.yml down --remove-orphans",
    "clean": "rimraf dist coverage",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --config .prettierrc --write .",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:dev": "vitest dev",
    "test:cov": "vitest run --coverage",
    "release": "npx semantic-release --no-ci",
    "prepare": "husky"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@aws-sdk/client-s3": "^3.958.0",
    "@getbrevo/brevo": "^3.0.1",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "envalid": "^8.0.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "mongoose": "^8.4.1",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.16",
    "pino-http": "^10.0.0",
    "redis": "^4.7.0",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^10.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.1.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.0.3",
    "@types/aws-lambda": "^8.10.149",
    "@types/base-64": "^1.0.2",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/moment": "^2.11.29",
    "@types/multer": "^1.4.13",
    "@types/node-schedule": "^2.1.7",
    "@types/nodemailer": "^6.4.17",
    "@types/redlock": "^4.0.7",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.12.0",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "@vitest/coverage-v8": "^3.0.9",
    "commitlint": "^19.6.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.2",
    "pino-pretty": "^11.0.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "semantic-release": "^24.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "tsup": "^8.0.2",
    "tsx": "^4.7.2",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^3.0.9"
  },
  "lint-staged": {
    "**/*": "npm run format",
    "**/*.{js,ts}": "npm run lint:fix"
  },
  "repository": "Slark-labs/unify-posts-backend",
  "license": "ISC"
}
