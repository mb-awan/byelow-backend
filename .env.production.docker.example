NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# APP URLs (prod, Docker)
FRONTEND_URL=https://byelow.net
BACKEND_BASE_URL=https://api.byelow.net
DASHBOARD_BASE_URL=https://app.byelow.net
ADMIN_BASE_URL=https://admin.byelow.net

# CORS Settings
CORS_ORIGIN='https://byelow.net;https://api.byelow.net;https://app.byelow.net;https://admin.byelow.net'

# MongoDB Configuration (prod - cloud MongoDB or managed)
MONGO_URL=mongodb://mongodb:27017/byelow

# JWT Configuration
JWT_SECRET_KEY=change-me
JWT_EXPIRES_IN=1d

# Bcrypt Configuration
BCRYPT_SALT_ROUNDS=10

# REDIS (prod - cloud Redis or docker `redis`)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=
REDIS_TLS=false

# AI Service URL (inside Docker network)
AI_SERVICE_URL=http://ai-service:8000

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# GOOGLE OAUTH CREDENTIALS
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# BREVO SMTP
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=
SMTP_PASSWORD=
SMTP_FROM_EMAIL_NO_REPLY=no-reply@byelow.net
SMTP_FROM_NAME=Byelow

# dataforseo credentials
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ANALYSIS CONTROLS
DOMAIN_ANALYSIS_CACHE_TTL_DAYS=30

