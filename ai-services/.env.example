DEBUG=false

# Redis / Celery (optional; DA/PA async workers)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# DataForSEO credentials (for Backlink Indexer)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Notes:
# - In Docker dev/prod, these env vars can also come from the root
#   .env.development.docker / .env.production.docker files.
# - For local ai-services-only runs, copy this file to `.env` and fill values.

